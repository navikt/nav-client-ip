{
	"name": "@navikt/client-ip",
	"version": "1.0.1",
	"description": "The client's IP address for Node apps on Nais, resolved from the socket address and X-Forwarded-For",
	"license": "MIT",
	"repository": "navikt/nav-client-ip",
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./astro": {
			"types": "./dist/astro.d.mts",
			"default": "./dist/astro.mjs"
		},
		"./express": {
			"types": "./dist/express.d.mts",
			"default": "./dist/express.mjs"
		},
		"./hono": {
			"types": "./dist/hono.d.mts",
			"default": "./dist/hono.mjs"
		},
		"./next": {
			"types": "./dist/next.d.mts",
			"default": "./dist/next.mjs"
		}
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"build": "tsdown",
		"lint": "oxfmt --check && oxlint && tsc --noEmit",
		"format": "oxfmt",
		"test": "node --test \"test/**/*.test.ts\""
	},
	"devDependencies": {
		"@astrojs/node": "11.1.14",
		"@hono/node-server": "2.1.11",
		"@types/express": "5.0.6",
		"@types/node": "26.6.5",
		"astro": "7.4.13",
		"express": "5.3.0",
		"hono": "4.13.19",
		"next": "16.4.6",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tsdown": "0.22.14",
		"typescript": "6.0.3"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
